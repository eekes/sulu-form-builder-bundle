{#
    "Summary": for the team - what was sent comes first, with the page, the language and the time,
    and a button to the submissions in the admin. The text of the notification follows below.
#}
{% extends '@EekesSuluFormBuilder/email/base.html.twig' %}

{% block content %}
    <tr>
        <td class="eekes-card eekes-padding" style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 32px 40px 36px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
                <tr>
                    <td style="padding-bottom: 4px;">
                        <span style="display: inline-block; padding: 3px 10px; border-radius: 999px; background: {{ accent }}; color: #ffffff; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;">{{ 'eekes_form_builder.email.new_submission'|trans({}, 'eekes_form_builder') }}</span>
                    </td>
                </tr>
                <tr>
                    <td class="eekes-title" style="padding: 8px 0 4px; font-size: 20px; font-weight: 700; line-height: 1.3; color: #111827;">{{ definition.title }}</td>
                </tr>
                <tr>
                    <td class="eekes-muted" style="padding-bottom: 22px; font-size: 13px; color: #6b7280;">
                        {{ submission.createdAt|date('d-m-Y H:i') }} · {{ submission.locale|upper }}
                        {%- if submission.url is not empty %} · <a href="{{ submission.url }}" style="color: #6b7280;">{{ submission.url|split('?')|first|replace({'https://': '', 'http://': ''})|trim('/') }}</a>{% endif %}
                    </td>
                </tr>
                {%- if values is not empty %}
                    <tr>
                        <td>{% include '@EekesSuluFormBuilder/email/_answers.html.twig' %}</td>
                    </tr>
                {%- endif %}
                {%- if body is not empty %}
                    <tr>
                        <td class="eekes-text" style="padding-top: 22px; font-size: 14px; line-height: 1.6; color: #374151;">{{ body|raw }}</td>
                    </tr>
                {%- endif %}
                {%- if admin_url is not empty %}
                    <tr>
                        <td style="padding-top: 24px;">
                            <a href="{{ admin_url }}" style="display: inline-block; padding: 11px 20px; border-radius: 6px; background: {{ accent }}; color: #ffffff; font-size: 14px; font-weight: 600; text-decoration: none;">{{ 'eekes_form_builder.email.open_in_admin'|trans({}, 'eekes_form_builder') }}</a>
                        </td>
                    </tr>
                {%- endif %}
            </table>
        </td>
    </tr>
{% endblock %}
