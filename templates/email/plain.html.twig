{#
    "Plain": reads like a personal e-mail - no card, no colour, just the text and, when asked for,
    the answers. Suits a confirmation to the visitor.
#}
{% extends '@EekesSuluFormBuilder/email/base.html.twig' %}

{% block content %}
    <tr>
        <td class="eekes-card eekes-padding" style="background: #ffffff; padding: 40px 44px; border-radius: 10px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
            {%- if body is not empty %}
                <div class="eekes-text" style="font-size: 16px; line-height: 1.7; color: #1f2937;">{{ body|raw }}</div>
            {%- endif %}
            {%- if include_values and values is not empty %}
                <div class="eekes-muted" style="padding: 18px 0 10px; font-size: 13px; color: #6b7280;">{{ 'eekes_form_builder.email.answers'|trans({}, 'eekes_form_builder') }}</div>
                {% include '@EekesSuluFormBuilder/email/_answers.html.twig' %}
            {%- endif %}
            <div class="eekes-title" style="padding-top: 28px; font-size: 15px; font-weight: 600; color: #111827;">{{ brand }}</div>
        </td>
    </tr>
{% endblock %}
