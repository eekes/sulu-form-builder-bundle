<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:xi="http://www.w3.org/2001/XInclude"
      xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>eekes_form_builder_field_file</key>

    <properties>
        <xi:include href="../forms-partials/field_label.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/*)"/>
        <xi:include href="../forms-partials/field_help.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/*)"/>
        <xi:include href="../forms-partials/field_required.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/*)"/>
        <xi:include href="../forms-partials/field_show_in_list.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/*)"/>
        <section name="validation">
            <meta>
                <title>eekes_form_builder.field.validation</title>
            </meta>
            <properties>
                <property name="multiple" type="checkbox" colspan="12">
                    <meta>
                        <title>eekes_form_builder.field.multiple_files</title>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="label" value="eekes_form_builder.field.multiple_files_label"/>
                    </params>
                </property>
                <property name="maxSize" type="number" colspan="6">
                    <meta>
                        <title>eekes_form_builder.field.max_size</title>
                        <info_text>eekes_form_builder.field.max_size_info</info_text>
                    </meta>
                </property>
                <property name="extensions" type="text_line" colspan="6">
                    <meta>
                        <title>eekes_form_builder.field.extensions</title>
                        <info_text>eekes_form_builder.field.extensions_info</info_text>
                    </meta>
                </property>
            </properties>
        </section>
        <section name="advanced">
            <meta>
                <title>eekes_form_builder.field.advanced</title>
            </meta>
            <properties>
                <xi:include href="../forms-partials/field_key.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/*)"/>
            </properties>
        </section>
    </properties>
</form>
