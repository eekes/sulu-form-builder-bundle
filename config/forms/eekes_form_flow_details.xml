<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>eekes_form_flow_details</key>

    <properties>
        <property name="name" type="text_line" mandatory="true" colspan="8">
            <meta>
                <title>eekes_form_builder.flow_name</title>
                <info_text>eekes_form_builder.flow_name_info</info_text>
            </meta>
        </property>
        <property name="enabled" type="checkbox" colspan="4">
            <meta>
                <title>eekes_form_builder.enabled</title>
            </meta>
            <params>
                <param name="type" value="toggler"/>
                <param name="default_value" value="true"/>
                <param name="label" value="eekes_form_builder.flow_enabled_label"/>
            </params>
        </property>

        <property name="flow" type="eekes_form_builder_flow" colspan="12">
            <meta>
                <title>eekes_form_builder.integration</title>
            </meta>
        </property>

        <section name="conditions_section">
            <meta>
                <title>eekes_form_builder.conditions</title>
                <info_text>eekes_form_builder.flow_conditions_info</info_text>
            </meta>
            <properties>
                <property name="conditions" type="eekes_form_builder_conditions" colspan="12">
                    <meta>
                        <title>eekes_form_builder.conditions</title>
                    </meta>
                </property>
            </properties>
        </section>
    </properties>
</form>
